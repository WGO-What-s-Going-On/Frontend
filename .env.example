# 복사해서 .env.local로 쓰기 (cp .env.example .env.local). 비워 두면 목업 데이터로만 동작
VITE_API_BASE_URL=https://d35lxgeutzw8c6.cloudfront.net
VITE_WS_URL=wss://d35lxgeutzw8c6.cloudfront.net/ws/v1
# 카카오 로그인: 백엔드와 같은 REST API 키, 같은 redirect URI (비우면 목업 로그인)
VITE_KAKAO_REST_API_KEY=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
# 게시글 · 댓글 · 알림 · 활동 화면을 실제 서버로 (로그인 확인 후 true)
VITE_SERVER_POSTS=false
# 브라우저 위치를 못 받을 때 쓰는 개발용 위치 (중앙대)
VITE_DEV_LATLNG=37.5048,126.9573
