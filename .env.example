# 복사해서 .env.local로 쓰기 (cp .env.example .env.local). 비워 두면 목업 데이터로만 동작
VITE_API_BASE_URL=https://api.136-81-245-176.sslip.io
VITE_WS_URL=wss://ws.136-81-245-176.sslip.io/ws/v1
# 카카오 로그인: 백엔드와 같은 REST API 키, 같은 redirect URI (비우면 목업 로그인)
VITE_KAKAO_REST_API_KEY=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
# 카카오 지도 JavaScript 키 (비우면 그림 지도). Kakao Developers > 플랫폼 > Web 사이트 도메인에 http://localhost:5173 등록
VITE_KAKAO_JS_KEY=
# 게시글 · 댓글 · 알림 · 활동 화면을 실제 서버로 (로그인 확인 후 true)
VITE_SERVER_POSTS=false
# 브라우저 위치를 못 받을 때 쓰는 개발용 위치 (중앙대)
VITE_DEV_LATLNG=37.5048,126.9573
# 개발 서버 전용 테스트 계정 토큰 (카카오 로그인 전 서버 연동 확인용). .env.local에만 넣고 커밋하지 않는다
VITE_DEV_ACCESS_TOKEN=
# 웹 푸시(PWA): Firebase 콘솔 > 프로젝트 설정 > 웹 앱 설정값, 클라우드 메시징 > 웹 푸시 인증서(VAPID 공개키)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
